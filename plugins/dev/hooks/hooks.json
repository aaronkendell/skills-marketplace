{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}\"; pnpm exec tsx \"$PLUGIN_ROOT/hooks/workspace-context.ts\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}\"; pnpm exec tsx \"$PLUGIN_ROOT/hooks/docs-freshness.ts\""
					}
				]
			}
		]
	}
}
