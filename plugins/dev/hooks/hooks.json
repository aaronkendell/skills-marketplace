{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "pnpm exec tsx \"${CLAUDE_PLUGIN_ROOT}/hooks/workspace-context.ts\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "pnpm exec tsx \"${CLAUDE_PLUGIN_ROOT}/hooks/docs-freshness.ts\""
					}
				]
			}
		]
	}
}
